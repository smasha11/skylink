# Skylink Global Network — Apache / LiteSpeed settings (Hostinger)

ErrorDocument 404 /404.html

# Force HTTPS (enable after your SSL certificate is active in hPanel)
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Never serve the build tools folder if it is uploaded by mistake
RedirectMatch 404 ^/_build(/|$)
# Design-process files (Impeccable) are never served
RedirectMatch 404 ^/\.impeccable(/|$)
RedirectMatch 404 ^/(PRODUCT|DESIGN)\.md$

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
